# Copy only into your PRIVATE environment; never commit real secrets.
DATABASE_URL=sqlite:///./qwoms.db
QWOMS_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
QWOMS_COOKIE_SECURE=false
QWOMS_STORAGE_ROOT=./local-storage
QWOMS_STORAGE_BACKEND=local
# For approved private S3-compatible storage: set backend=s3 and configure SDK identity/region securely.
# QWOMS_S3_BUCKET=your-approved-private-bucket
# QWOMS_S3_PREFIX=development
# QWOMS_S3_ENDPOINT_URL=https://your-approved-endpoint
